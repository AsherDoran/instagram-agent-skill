# Copy to .env.local and fill in. Generate secrets with: npm run gen-secrets

# --- Authentication (required) ---
# Password for the single admin login. Use a long random value.
ADMIN_PASSWORD=
# Random 32+ char string used to sign session cookies.
SESSION_SECRET=
# 32 bytes, hex (64 chars) or base64. Encrypts stored OAuth tokens/API keys (AES-256-GCM).
ENCRYPTION_KEY=

# --- Storage ---
DATABASE_PATH=./data/command-center.db

# --- AI provider (optional; PAID API – off by default) ---
# "rules" = built-in deterministic planner (free, default).
# "anthropic" calls the paid Anthropic API for planning; only enable deliberately.
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google OAuth (optional; Gmail / Calendar / Sheets) ---
# Create a Web OAuth client in Google Cloud Console; redirect URI:
#   http://localhost:3000/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
